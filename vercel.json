{
  "version": 2,
  "public": "public",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "Build/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "^/Build/(.*)$",
      "dest": "/Build/$1"
    },
    {
      "src": "^/\\.well-known/(.*)$",
      "dest": "/public/.well-known/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
